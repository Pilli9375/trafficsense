venv/
env/
.env

# Large model files
*.pt
*.pth
*.gguf
*.onnx
*.engine

# Dataset folders (keep folder, ignore contents)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Output videos
outputs/detection_videos/*.mp4
outputs/detection_videos/*.avi

# IDE files
.vscode/
.idea/

# OS files
Thumbs.db
.DS_Store

# Jupyter checkpoints
.ipynb_checkpoints/
outputs/perception_demo/*.mp4
outputs/synthetic_perception.json
tests/mock_ollama.py

# Added in Phase 0
.venv/
data/external/
outputs/runs/
*.egg-info/

# Per-step metrics of the Indian 2x2 batch runs (large; summary.json files are tracked)
outputs/indian_2x2/runs/*/metrics.csv
outputs/indian_2x2/superseded_runs/*/metrics.csv

# Per-step metrics of the baseline tuning runs (large; summary.json files are tracked)
outputs/baselines/**/metrics.csv

# Per-step metrics of the full experiments (large; summary.json and decisions.jsonl are tracked)
outputs/full/runs/*/metrics.csv
outputs/emergency/runs/*/metrics.csv

# Perception images (sample grids, alignment checks) stay local; reports (.json) are tracked
outputs/perception/*.jpg

# Per-step metrics of the camera-error runs (large; summary.json, decisions.jsonl, noise.jsonl are tracked)
outputs/camera_error/runs/*/metrics.csv
outputs/camera_error/decomposition/runs/*/metrics.csv

# Report build: page images rendered for the layout check (scripts/build_report.py --pages)
docs/report/build/
